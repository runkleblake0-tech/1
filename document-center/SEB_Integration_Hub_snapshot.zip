=== index.html ===

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SEB Integration Hub</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <h1>SEB Integration Hub</h1>
      <button id="themeToggle">Toggle theme</button>
      <nav id="nav">
        <ul id="navLinks">
          <li><a href="#sentinel">SENTINEL Analysis</a></li>
          <li><a href="#endpoints">Endpoint Registry</a></li>
          <li><a href="#deployment">Deployment Model</a></li>
          <li><a href="#download">Download package</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section id="sentinel">
        <h2>SENTINEL Analysis</h2>
        <p>Overview content goes here.</p>
      </section>

      <section id="endpoints">
        <h2>Endpoint Registry</h2>
        <p>Endpoint information and registry details.</p>
      </section>

      <section id="deployment">
        <h2>Deployment Model</h2>
        <p>Deployment notes and architecture details.</p>
      </section>

      <section id="download">
        <h2>Download package</h2>
        <p><a href="#">Download</a></p>
      </section>
    </main>

    <script type="module" src="/script.js"></script>
  </body>
</html>

